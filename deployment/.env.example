# Copy to deployment/.env before running `docker compose up`.

POSTGRES_USER=tsunagi
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=tsunagi

# Legacy shared enrolment secret. Leave it commented out: devices are added
# with single-use codes generated on the dashboard's Devices page, which cannot
# be reused and expire in minutes.
# TSUNAGI_SETUP_KEY=change-me-too

# How long an enrolment code stays valid (default 900 = 15 minutes).
# TSUNAGI_ENROLMENT_TOKEN_TTL_SECONDS=900

# Optional: pin the admin API key instead of reading it out of the API logs.
# Must start with tsn_key_ or the prefix is added for you.
# TSUNAGI_BOOTSTRAP_API_KEY=tsn_key_your-admin-key

TSUNAGI_CORS_ORIGINS=http://localhost:8080
HTTP_PORT=8080

# Rate limiting, applied per credential (or per address when unauthenticated).
# TSUNAGI_RATE_LIMIT_REQUESTS=240
# TSUNAGI_RATE_LIMIT_WINDOW_SECONDS=60
# TSUNAGI_RATE_LIMIT_ENABLED=true

# Required only for the TLS overlay; see TLS.md.
# TSUNAGI_DOMAIN=tsunagi.example.com
