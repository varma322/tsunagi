# Database. SQLite for local development, PostgreSQL in production.
TSUNAGI_DATABASE_URL=sqlite+aiosqlite:///./tsunagi.db
# TSUNAGI_DATABASE_URL=postgresql+asyncpg://tsunagi:tsunagi@postgres:5432/tsunagi

# Redis. Optional: when unset, an in-process event bus is used instead, which
# works for a single API worker but not across replicas.
# TSUNAGI_REDIS_URL=redis://redis:6379/0

# Legacy shared enrolment secret. Leave it unset: devices are registered with
# single-use codes issued from the dashboard, which expire and cannot be reused.
# Setting this re-enables the old shared-password flow.
# TSUNAGI_SETUP_KEY=change-me

# How long an enrolment code stays valid (default 900 = 15 minutes).
TSUNAGI_ENROLMENT_TOKEN_TTL_SECONDS=900

# Create tables on startup instead of running Alembic. Development only.
TSUNAGI_AUTO_CREATE_SCHEMA=true

# Seconds since last_seen within which a device counts as online.
TSUNAGI_DEVICE_ONLINE_WINDOW_SECONDS=300

# Comma-separated CORS origins for the dashboard.
TSUNAGI_CORS_ORIGINS=http://localhost:5173

# Rate limiting, counted per credential (or per address when unauthenticated).
# The default is far above normal use: the phone batches its uploads.
TSUNAGI_RATE_LIMIT_ENABLED=true
TSUNAGI_RATE_LIMIT_REQUESTS=240
TSUNAGI_RATE_LIMIT_WINDOW_SECONDS=60

# Admin key minted on a fresh database. Leave unset and the server generates one
# and logs it once at startup.
# TSUNAGI_BOOTSTRAP_API_KEY=tsn_key_<openssl rand -hex 24>

# --- production settings: these belong in deployment/.env, not here ---
# POSTGRES_PASSWORD and TSUNAGI_DOMAIN are read by docker-compose, not by the
# app, and a second TSUNAGI_CORS_ORIGINS would override the development default
# above and block the Vite dev server on :5173.
#
# POSTGRES_PASSWORD=<openssl rand -base64 24>
# TSUNAGI_DOMAIN=sms.allbluesourcing.com
# TSUNAGI_CORS_ORIGINS=https://sms.allbluesourcing.com

