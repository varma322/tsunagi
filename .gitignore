# Backend
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
# Databases and their backups. The suffix glob matters: a file named
# tsunagi.db.bak-<date> is not matched by *.db and would otherwise be committed
# with real message contents in it.
backend/*.db
backend/*.db-*
backend/*.db.*
backend/.env
backend/.pytest_cache/

# Deployment secrets
deployment/.env

# Android release signing — never commit these
keystore.properties
*.jks
*.keystore
frontend/dist.tar.gz
